class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    # Insert at end
    def insert_at_end(self, data):
        new_node = Node(data)

        if self.head is None:
            self.head = new_node
            return

        temp = self.head

        while temp.next is not None:
            temp = temp.next

        temp.next = new_node

    # Delete from kth position
    def delete_at_kth(self, k):

        # Case 1: Empty list
        if self.head is None:
            print("List is empty")
            return

        # Case 2: Delete first node
        if k == 1:
            self.head = self.head.next
            return

        # Move to (k-1)th node
        temp = self.head

        for i in range(k - 2):
            if temp.next is None:
                print("Invalid position")
                return

            temp = temp.next

        # Check if kth node exists
        if temp.next is None:
            print("Invalid position")
            return

        # Delete kth node
        temp.next = temp.next.next

    # Display linked list
    def display(self):
        temp = self.head

        while temp is not None:
            print(temp.data, end=" -> ")
            temp = temp.next

        print("None")


# Main program
ll = LinkedList()

ll.insert_at_end(10)
ll.insert_at_end(20)
ll.insert_at_end(30)
ll.insert_at_end(40)
ll.insert_at_end(50)

print("Original list:")
ll.display()

# Delete node at position 3
ll.delete_at_kth(3)

print("After deleting position 3:")
ll.display()
