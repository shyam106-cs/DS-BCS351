class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    # Insert at kth position
    def insert_at_kth(self, data, k):
        new_node = Node(data)

        # Case 1: Insert at first position
        if k == 1:
            new_node.next = self.head
            self.head = new_node
            return

        # Move to (k-1)th node
        temp = self.head

        for i in range(k - 2):
            if temp is None:
                print("Invalid position")
                return
            temp = temp.next

        # If position is invalid
        if temp is None:
            print("Invalid position")
            return

        # Insert the new node
        new_node.next = temp.next
        temp.next = new_node

    # Display linked list
    def display(self):
        temp = self.head

        while temp is not None:
            print(temp.data, end=" -> ")
            temp = temp.next

        print("None")


# Main program
ll = LinkedList()

# Creating linked list
ll.insert_at_kth(10, 1)
ll.insert_at_kth(20, 2)
ll.insert_at_kth(30, 3)

print("Original list:")
ll.display()

# Insert 15 at position 2
ll.insert_at_kth(15, 2)

print("After insertion:")
ll.display()
   